<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>CustomMaps.Tests</AssemblyName>
    <RootNamespace>CustomMaps.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Links the production source directly, with NO reference assemblies: the tests
    exercise the files that ship, not a copy, and the absence of references is what
    mechanically enforces that Core/ stays free of Unity and game types.

    Core/ is the pure logic the plugin runs — naming, grid maths, catalogue merge,
    manifest validation — and the binary formats it reads. The map generator and its
    tests moved to the sibling NOMapForge repository, which keeps its own copy of Core/
    as the writing side of the same contract.
  -->
  <ItemGroup>
    <Compile Include="..\..\Core\**\*.cs" LinkBase="Production\Core" />
    <!-- Pure arithmetic outside Core/, plugin-only, so it has no copy in NOMapForge. -->
    <Compile Include="..\..\BlastReach.cs" Link="Production\BlastReach.cs" />
    <!-- What each floating-origin shift cost, and the log's lines about it; ShiftTiming feeds it
         from the game's player loop. -->
    <Compile Include="..\..\ShiftStats.cs" Link="Production\ShiftStats.cs" />
    <!-- The one piece of the plugin's own logic free of game types: how a mission's choice of
         an airbase flag and capture range is told from a copy of the map's. -->
    <Compile Include="..\..\AirbaseChoice.cs" Link="Production\AirbaseChoice.cs" />
    <!-- The raised lakes as the game's water sees them: footprints, heights and the datum's
         arithmetic, under LakeWater and the patches that point the game's water tests at it. -->
    <Compile Include="..\..\LakeSurfaces.cs" Link="Production\LakeSurfaces.cs" />
    <!-- The validation block's line about a map's buildings, worded apart from the game's types. -->
    <Compile Include="..\..\BuildingsReport.cs" Link="Production\BuildingsReport.cs" />
    <!-- A bundle's full-file SHA-256, its map's multiplayer identity, and the cache that remembers it
         between starts; run against real files. -->
    <Compile Include="..\..\BundleHash.cs" Link="Production\BundleHash.cs" />
    <!-- The stream a .nomapz bundle is loaded through: chunks decoded as they are read, cached and
         read ahead on worker threads. -->
    <Compile Include="..\..\NomapzStream.cs" Link="Production\NomapzStream.cs" />
    <!-- Which installed bundle a map key starts reading in the background. -->
    <Compile Include="..\..\WarmUpPolicy.cs" Link="Production\WarmUpPolicy.cs" />
    <!-- Which loaded materials the shader-name fallbacks pass over: copies owned by a map on its way out. -->
    <Compile Include="..\..\MaterialNames.cs" Link="Production\MaterialNames.cs" />
    <!-- What an airbase is built from its taxi lanes: its roads, each runway's exits and which way
         each faces, its service point and landing pad. -->
    <Compile Include="..\..\TaxiPlan.cs" Link="Production\TaxiPlan.cs" />
    <!-- How a mission's own airbase roads are told from a copy of the map's, and the runway exits
         made for them. -->
    <Compile Include="..\..\MissionTaxiRoads.cs" Link="Production\MissionTaxiRoads.cs" />
    <!-- The cells a map's buildings are filed under, and each building's collision box: where it
         stands, which way it faces, and the merged mesh of a cell's boxes. -->
    <Compile Include="..\..\CityProxies.cs" Link="Production\CityProxies.cs" />
    <!-- The load passes' names: which surface a map's placeholder material asks for, and which
         subtree a renderer sits in with each transform's name read once. -->
    <Compile Include="..\..\MaterialMarkers.cs" Link="Production\MaterialMarkers.cs" />
    <Compile Include="..\..\AncestorNames.cs" Link="Production\AncestorNames.cs" />
    <!-- The road route search the plugin answers the game's RoadPathfinder with on a custom map, and the
         fingerprint that keeps it to the game build it was checked against. -->
    <Compile Include="..\..\RoadPathSearch.cs" Link="Production\RoadPathSearch.cs" />
    <Compile Include="..\..\IlFingerprint.cs" Link="Production\IlFingerprint.cs" />
    <!-- How far out the HUD's landing glideslope starts on a custom map, and the fingerprint of the game
         methods its patch edits and copies. -->
    <Compile Include="..\..\ApproachLine.cs" Link="Production\ApproachLine.cs" />
    <!-- The custom map tiles in the mission editor's New Mission panel: their order and labels, the
         scrolling list's size, scrolling a tile into view, the cached pictures' names, and the
         fingerprint of the game methods the tiles rely on. -->
    <Compile Include="..\..\MapTiles.cs" Link="Production\MapTiles.cs" />
    <!-- How far out the M map zooms on a custom map, and how far it pans there. -->
    <Compile Include="..\..\MapZoom.cs" Link="Production\MapZoom.cs" />
    <!-- How high and how fast AI aircraft and helicopters have to fly to clear the ground ahead,
         from heights the patches sample: geometry and arithmetic only. -->
    <Compile Include="..\..\TerrainEnvelope.cs" Link="Production\TerrainEnvelope.cs" />
    <Compile Include="..\..\RotorPlan.cs" Link="Production\RotorPlan.cs" />
  </ItemGroup>

</Project>
